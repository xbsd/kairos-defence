{
  "name": "kairos-defense-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run check:types && npm run test",
    "gen:types": "openapi-typescript openapi.json -o src/api/types.gen.ts && prettier --write src/api/types.gen.ts",
    "check:types": "node scripts/check-types.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@react-three/drei": "~10.7.9",
    "@react-three/fiber": "~9.8.2",
    "@react-three/postprocessing": "~3.2.2",
    "d3": "^7.9.0",
    "motion": "~14.7.1",
    "postprocessing": "~6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "~0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
